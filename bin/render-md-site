#!/usr/bin/env python3
"""render-md-site [repo] — render a Markdown repo to <repo>/_site with Apex.

Apex renders each Markdown document to an HTML fragment; this script supplies
site navigation, per-page tables of contents, link rewriting, and the shared
HTML shell. The output tree mirrors the source tree, so a/b/c.md becomes
_site/a/b/c.html and existing relative links keep working.

Usage:
  render-md-site                       # render $PWD
  render-md-site ~/gitlake --title GitLake --exclude 'agent_docs/**'
  render-md-site --after-body mermaid  # inject the mermaid initialiser
"""

from __future__ import annotations

import argparse
import functools
import html
import posixpath
import re
import shutil
import subprocess
import sys
from pathlib import Path, PurePosixPath

# Excluded everywhere unless --no-default-excludes. These are agent and
# repo-hygiene files that are never site content; every _quarto.yml on the
# fleet excludes the same set by hand.
# Applied ALWAYS, even when --include names files explicitly. These are build
# output and VCS internals; rendering them is never intended. iv-docs keeps its
# Quarto profile output in _site-internal/ and _site-product/, and excluding
# only "_site/**" made apex walk that previous HTML as source — 241 pages
# instead of ~50.
ALWAYS_EXCLUDES = [
    "_site*/**",
    ".quarto/**",
    ".git/**",
    ".entire/**",
    "node_modules/**",
    ".venv/**",
    ".github/**",
]

DEFAULT_EXCLUDES = [
    "AGENTS.md",
    "CLAUDE.md",
    "TODO.md",
    "CHANGELOG.md",
    # Nested READMEs stay excluded: they are directory notes, not site pages,
    # and rendering them alongside an index.md in the same directory produces
    # two near-duplicate pages. The ROOT README.md is handled separately -- see
    # ROOT_README_FALLBACK below -- because it is the one document a repo
    # reliably has, and a site whose landing page is a redirect stub is worse
    # than one whose landing page is the README.
    "**/README.md",
]

# A repo with no index.md but with a README.md gets the README as its landing
# page. Previously the root was a `<meta refresh>` stub pointing at whatever
# sorted first -- for fannie-sflpd-poc that was control/schemas/, i.e. the site
# opened on a schema reference. README is what the author already wrote to
# introduce the repo, so use it, and say so in the render output rather than
# doing it silently. An explicit index.md still wins; so does an explicit
# --exclude README.md.
ROOT_README_FALLBACK = True

# Mermaid, as a named preset rather than a pasted <script>: gitlake's
# _quarto.yml carried this verbatim under include-after-body, and copying such
# blobs between repos is how they rot. Kept byte-compatible with what that site
# already served.
AFTER_BODY_PRESETS = {
    "mermaid": """<script type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
  mermaid.initialize({ startOnLoad: false, securityLevel: 'loose' });
  let i = 0;
  // Apex emits ```mermaid as <pre lang="mermaid"><code>; the
  // other selectors cover renderers that use a class or lang attribute.
  for (const el of document.querySelectorAll('pre[lang="mermaid"] > code, pre.mermaid, div.mermaid, pre > code.language-mermaid')) {
    const host = el.tagName === 'CODE' ? el.parentElement : el;
    try {
      const { svg } = await mermaid.render('mmd-' + (i++), el.textContent.trim());
      host.innerHTML = svg;
    } catch (e) { console.error('mermaid render error:', e); }
  }
</script>""",
}

CSS = """
:root { --fg:#1f2328; --bg:#fff; --muted:#59636e; --accent:#0969da; --border:#d1d9e0; --code-bg:#f6f8fa; }
@media (prefers-color-scheme: dark) {
  :root { --fg:#e6edf3; --bg:#0d1117; --muted:#9198a1; --accent:#4493f8; --border:#3d444d; --code-bg:#151b23; }
}
* { box-sizing: border-box; }
body { margin:0; font:16px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
       color:var(--fg); background:var(--bg); }
.layout { display:flex; align-items:flex-start; max-width:1400px; margin:0 auto; }
nav.sidebar { flex:0 0 260px; padding:1.5rem 1rem; border-right:1px solid var(--border);
              position:sticky; top:0; max-height:100vh; overflow-y:auto; }

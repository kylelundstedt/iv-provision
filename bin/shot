#!/usr/bin/env python3
"""shot <url> <out.png> [width height] — screenshot a URL with the image's
headless Chromium, driven over CDP (--remote-debugging-port + a tiny stdlib
WebSocket client). Node-free, dependency-free (Python stdlib only).

Chromium comes from the exeuntu image at /headless-shell/headless-shell
(override with SHOT_CHROME).
"""
import base64
import json
import os
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.request

CHROME = os.environ.get("SHOT_CHROME", "/headless-shell/headless-shell")


def _recvn(s, n):
    buf = b""
    while len(buf) < n:
        c = s.recv(n - len(buf))
        if not c:
            raise EOFError("socket closed")
        buf += c
    return buf


def ws_connect(host, port, path):
    s = socket.create_connection((host, port), timeout=30)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\n"
               f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
               f"Sec-WebSocket-Version: 13\r\n\r\n").encode())
    data = b""
    while b"\r\n\r\n" not in data:
        data += s.recv(4096)
    return s


def ws_send(s, msg):
    payload = msg.encode()
    n = len(payload)
    header = bytearray([0x81])
    mask = os.urandom(4)
    if n < 126:
        header.append(0x80 | n)
    elif n < 65536:
        header.append(0x80 | 126)
        header += struct.pack(">H", n)
    else:
        header.append(0x80 | 127)
        header += struct.pack(">Q", n)
    header += mask
    s.sendall(bytes(header) + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))


def ws_recv(s):
    chunks = []
    while True:
        b0 = _recvn(s, 2)
        fin, opcode, ln = b0[0] & 0x80, b0[0] & 0x0f, b0[1] & 0x7f
        if ln == 126:
            ln = struct.unpack(">H", _recvn(s, 2))[0]
        elif ln == 127:
            ln = struct.unpack(">Q", _recvn(s, 8))[0]
        payload = _recvn(s, ln) if ln else b""
        if opcode == 0x8:
            raise EOFError("ws closed")
        chunks.append(payload)
        if fin:
            return b"".join(chunks).decode()


def main():
    if len(sys.argv) < 3:
        sys.exit("usage: shot <url> <out.png> [width height]")
    url, out = sys.argv[1], sys.argv[2]
    w = int(sys.argv[3]) if len(sys.argv) > 3 else 1280
    h = int(sys.argv[4]) if len(sys.argv) > 4 else 1000

    udd = tempfile.mkdtemp(prefix="iv-shot-")
    proc = subprocess.Popen(
        [CHROME, "--headless", "--no-sandbox", "--disable-gpu", "--hide-scrollbars",
         f"--window-size={w},{h}", f"--user-data-dir={udd}",
         "--remote-debugging-port=0", "about:blank"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    try:
        portfile = os.path.join(udd, "DevToolsActivePort")
        port = None
        for _ in range(150):
            if os.path.exists(portfile):
                first = open(portfile).read().splitlines()
                if first:
                    port = int(first[0])
                    break
            time.sleep(0.1)
        if not port:
            sys.exit("chrome did not open a debugging port")

        targets = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json"))
        page = next(t for t in targets if t.get("type") == "page")
        path = "/devtools/page/" + page["id"]
        s = ws_connect("127.0.0.1", port, path)

        seq = [0]

        def cmd(method, params=None):
            seq[0] += 1
            ws_send(s, json.dumps({"id": seq[0], "method": method, "params": params or {}}))
            return seq[0]

        cmd("Page.enable")
        nav = cmd("Page.navigate", {"url": url})
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            m = json.loads(ws_recv(s))
            if m.get("id") == nav and "error" in m:
                sys.exit(f"navigate error: {m['error']}")
            if m.get("method") == "Page.loadEventFired":
                break
        time.sleep(0.4)
        shot = cmd("Page.captureScreenshot", {"format": "png"})
        while True:
            m = json.loads(ws_recv(s))
            if m.get("id") == shot:
                if "error" in m:
                    sys.exit(f"screenshot error: {m['error']}")
                with open(out, "wb") as f:
                    f.write(base64.b64decode(m["result"]["data"]))
                break
        print("shot ->", out)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except Exception:
            proc.kill()
        shutil.rmtree(udd, ignore_errors=True)


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# Upstream owns package/distro/architecture handling; IV owns only version policy.
# This command never enables a server or changes remote-access configuration.
set -euo pipefail
rex_policy="$(cd "$(dirname "${BASH_SOURCE[0]}")/../provisioning/rex" && pwd)/release.json"
rex_temp=
rex_restore_hold=false
fail() { printf 'install-rex: %s\n' "$*" >&2; exit 1; }

load_policy() {
  jq -e '(.version | test("^[0-9][0-9A-Za-z.+~-]*$")) and
    (.channel == "snapshot" or .channel == "preview" or .channel == "stable") and
    .installer.url == "https://pkgs.superlogical.com/rex/install.sh" and
    (.installer.sha256 | test("^[0-9a-f]{64}$"))' "$rex_policy" >/dev/null || fail 'invalid installer/version policy'
  version=$(jq -r .version "$rex_policy"); channel=$(jq -r .channel "$rex_policy")
  installer_url=$(jq -r .installer.url "$rex_policy"); installer_sha=$(jq -r .installer.sha256 "$rex_policy")
}

# The first per-package pin permits the approved version; the next refuses all
# others, including newer snapshots and Ubuntu's unrelated Perl package.
write_preferences() {
  printf 'Package: rex\nPin: version %s\nPin-Priority: 1002\n\nPackage: rex\nPin: version *\nPin-Priority: -1\n\n' "$version"
}

package_state() {
  local record state maintainer
  record=$(dpkg-query -W -f='${db:Status-Abbrev}\t${Version}\t${Maintainer}' rex 2>/dev/null || true)
  installed=
  if [[ -n $record ]]; then
    IFS=$'\t' read -r state installed maintainer <<<"$record"
    if [[ $state == 'rc ' ]]; then installed=; return; fi
    [[ $state == 'ii ' || $state == 'hi ' ]] || fail 'Rex package is not fully installed'
    [[ $maintainer == *Superlogical* ]] || fail 'unrelated rex package installed; review explicitly'
  fi
}

verify_installed() {
  local result status=0 reported
  package_state
  [[ $installed == "$version" ]] || fail "installed Rex is ${installed:-absent}, not approved $version"
  result=$(dpkg --verify rex 2>&1) || status=$?
  (( status <= 1 )) || fail 'cannot verify installed package files'
  if grep -Eq '[[:space:]]/usr/bin/rex$' <<<"$result"; then fail 'executable differs from its package'; fi
  reported=$(binary_version)
  [[ $reported == "$version" ]] || fail 'executable/package version mismatch'
}

binary_version() { /usr/bin/rex version | awk 'NR == 1 {print $2}'; }

record_installation() {
  local action=$1 home lock temp
  install -d -m 0755 /var/lib/iv-rex
  temp=$(mktemp /var/lib/iv-rex/.installation.XXXXXX)
  jq -n --arg version "$version" --arg channel "$channel" --arg arch "$(dpkg --print-architecture)" \
    --arg installer_sha256 "$installer_sha" --arg binary_sha256 "$(sha256sum /usr/bin/rex | cut -d' ' -f1)" \
    --arg verified_utc "$(date -u +%FT%TZ)" --arg action "$action" \
    '{version:$version,channel:$channel,architecture:$arch,installer_sha256:$installer_sha256,
      binary_sha256:$binary_sha256,verified_utc:$verified_utc,update_policy:"apt-hold",
      action:$action,installer_executed:($action=="upstream-installed")}' > "$temp"
  chmod 0644 "$temp"; mv -T "$temp" /var/lib/iv-rex/installation.lock
  # Update only Rex's actual version, never pretend the full provisioner ran.
  home=$(getent passwd exedev | cut -d: -f6) || return 0
  [[ $home == /* ]] || fail 'exedev home must be absolute'
  lock="$home/iv-provision.lock"
  [[ -e $lock || -L $lock ]] || return 0
  [[ -f $lock && ! -L $lock ]] || fail 'IV lock is not a regular file'
  [[ $(grep -c '^rex_version=' "$lock" || true) -le 1 ]] || fail 'duplicate Rex version in IV lock'
  grep -qxF "rex_version=$version" "$lock" && return 0
  temp=$(mktemp "${lock%/*}/.iv-rex-lock.XXXXXX")
  awk -v v="$version" '/^rex_version=/ {print "rex_version=" v; found=1; next} {print}
    END {if (!found) print "rex_version=" v}' "$lock" > "$temp"
  chown --reference="$lock" "$temp"; chmod --reference="$lock" "$temp"; mv -T "$temp" "$lock"
}

cleanup() {
  if $rex_restore_hold; then apt-mark hold rex >/dev/null || true; fi
  [[ -z $rex_temp ]] || rm -rf -- "$rex_temp"
}

main() {
  local apply=false allow_change=false arg cache script action=verified-existing
  for arg in "$@"; do
    case "$arg" in
      --plan) apply=false ;;
      --apply) apply=true ;;
      --allow-version-change) allow_change=true ;;
      --help|-h) echo 'Usage: install-rex [--plan|--apply] [--allow-version-change]'; return ;;
      *) fail "unknown option $arg; remote access is separate: bin/configure-rex" ;;
    esac
  done
  for arg in jq dpkg dpkg-query apt-config sha256sum; do command -v "$arg" >/dev/null || fail "missing $arg"; done
  load_policy; package_state
  [[ -z $installed || $installed == "$version" || $allow_change == true ]] ||
    fail "existing Rex $installed is preserved; version changes require --allow-version-change"
  if [[ $installed == "$version" ]]; then verify_installed; fi
  printf 'Rex %s (%s), architecture %s: upstream installer; no server/network changes\n' \
    "$version" "$channel" "$(dpkg --print-architecture)"
  if ! $apply; then echo 'PLAN ONLY: no downloads or changes'; return; fi
  (( EUID == 0 )) || fail '--apply requires sudo'
  umask 077
  [[ ! -L /run/iv-rex.lock && ( ! -e /run/iv-rex.lock ||
     ( -f /run/iv-rex.lock && $(stat -c %u /run/iv-rex.lock) == 0 ) ) ]] || fail 'unsafe installation lock'
  exec 9>/run/iv-rex.lock
  chmod 0600 /run/iv-rex.lock
  flock -n 9 || fail 'another Rex installation is running'
  trap cleanup EXIT
  if [[ $installed != "$version" ]]; then
    cache=/var/cache/iv-rex
    [[ ! -L $cache ]] || fail 'unsafe installer cache'
    if [[ -e $cache ]]; then
      [[ -d $cache && $(stat -c '%u:%a' "$cache") == 0:755 ]] || fail 'cache must be root-owned mode 0755'
    fi
    install -d -m 0755 "$cache"
    rex_temp=$(mktemp -d "$cache/.upstream.XXXXXX")
    script="$cache/install-$installer_sha.sh"
    if [[ ! -e $script && ! -L $script ]]; then
      curl -q -fsSL --proto '=https' --proto-redir '=https' --max-time 120 \
        "$installer_url" -o "$rex_temp/install.sh"
      [[ $(sha256sum "$rex_temp/install.sh" | cut -d' ' -f1) == "$installer_sha" ]] || fail 'upstream installer changed; review checksum before updating'
      install -m 0644 "$rex_temp/install.sh" "$script"
    fi
    [[ -f $script && ! -L $script && $(stat -c '%u:%a' "$script") == 0:644 ]] || fail 'unsafe cached installer'
    [[ $(sha256sum "$script" | cut -d' ' -f1) == "$installer_sha" ]] || fail 'installer checksum mismatch'
    write_preferences > "$rex_temp/preferences"
    # A private, command-scoped APT config puts our version rule FIRST, without
    # editing host preferences. Other package rules are preserved unchanged.
    if [[ -f /etc/apt/preferences ]]; then cat /etc/apt/preferences >> "$rex_temp/preferences"; fi
    printf 'Dir::Etc::preferences "%s";\n' "$rex_temp/preferences" > "$rex_temp/apt.conf"
    [[ $(APT_CONFIG="$rex_temp/apt.conf" apt-config dump |
      sed -n 's/^Dir::Etc::preferences "\(.*\)";$/\1/p') == "$rex_temp/preferences" ]] ||
      fail 'host APT configuration overrides the requested version policy'
    if apt-mark showhold | grep -qx rex; then
      rex_restore_hold=true; apt-mark unhold rex >/dev/null
    fi
    env -u REX_PACKAGE_HOST -u REX_RELEASES_URL APT_CONFIG="$rex_temp/apt.conf" \
      sh "$script" --channel "$channel"
    action=upstream-installed
  fi
  verify_installed
  apt-mark hold rex >/dev/null; rex_restore_hold=false
  record_installation "$action"
  echo 'INSTALLED: approved upstream Rex, held; server/access configuration unchanged'
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi

{
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "ANTHROPIC_BASE_URL": "http://aperture.dojo-sun.ts.net"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/ssh-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking exe.dev SSH guard..."
          }
        ]
      }
    ]
  }
}
